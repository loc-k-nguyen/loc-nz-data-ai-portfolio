                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "No averaging of repeated source keys, no interpolation, no missing-to-zero fill.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "14pt",
                      "color": "#607068",
                      "fontWeight": "normal"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Rent affordability index is a change indicator, not an affordability league table.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "14pt",
                      "color": "#607068",
                      "fontWeight": "normal"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Consents are intentions to build; a single rent snapshot does not establish a trend.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "14pt",
                      "color": "#607068",
                      "fontWeight": "normal"
                    }
                  }
