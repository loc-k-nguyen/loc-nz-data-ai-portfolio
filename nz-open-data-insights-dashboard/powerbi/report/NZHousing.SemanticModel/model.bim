        "lineageTag": "00d0a647-fc77-4705-8c57-2fcf81992fab",
        "measures": [
          {
            "name": "Observed value",
            "expression": "IF(HASONEVALUE(Indicator[MetricID]) && COUNTROWS(Observation) = 1, MAX(Observation[Value]))",
            "formatStringDefinition": {
              "expression": "SELECTEDVALUE(Indicator[NumberFormat], \"#,0.##\")"
            },
            "lineageTag": "8e74498e-7cfc-488d-b523-6177dd60d91e"
          },
          {
            "name": "Latest date",
            "expression": "IF(HASONEVALUE(Indicator[MetricID]), CALCULATE(MAX(Observation[Date]), REMOVEFILTERS(Area), REMOVEFILTERS('Date')))",
            "lineageTag": "e183cf0b-db64-41a0-a712-e8e7a73a77d3"
          },
          {
            "name": "Latest value",
            "expression": "VAR d = [Latest date] RETURN IF(NOT ISBLANK(d), CALCULATE([Observed value], REMOVEFILTERS('Date'), 'Date'[Date] = d))",
            "formatStringDefinition": {
              "expression": "SELECTEDVALUE(Indicator[NumberFormat], \"#,0.##\")"
            },
            "lineageTag": "199c028e-3bc0-4241-8889-bf5d527fd073"
          },
          {
            "name": "Selected area latest",
            "expression": "IF(HASONEVALUE('Area picker'[AreaID]), CALCULATE([Latest value], REMOVEFILTERS(Area), TREATAS(VALUES('Area picker'[AreaID]), Area[AreaID])))",
            "formatStringDefinition": {
              "expression": "SELECTEDVALUE(Indicator[NumberFormat], \"#,0.##\")"
            },
            "lineageTag": "8bd90562-065c-4c41-9875-788ba566f9cb"
          },
          {
            "name": "Selected area trend",
            "expression": "IF(HASONEVALUE('Area picker'[AreaID]), CALCULATE([Observed value], REMOVEFILTERS(Area), TREATAS(VALUES('Area picker'[AreaID]), Area[AreaID])))",
            "formatStringDefinition": {
              "expression": "SELECTEDVALUE(Indicator[NumberFormat], \"#,0.##\")"
            },
            "lineageTag": "6442dca7-4ec3-4f70-be2c-905fce5e442e"
          },
          {
            "name": "Selected area display",
            "expression": "VAR v = [Selected area latest] RETURN IF(ISBLANK(v), \"Not available\", FORMAT(v, SELECTEDVALUE(Indicator[NumberFormat], \"#,0\")))",
            "lineageTag": "11c09c45-789a-41c7-8c1c-766ebf6a7ce4"
          },
          {
            "name": "Observation date",
            "expression": "IF(ISBLANK([Latest date]), \"Select one metric\", FORMAT([Latest date], \"d mmm yyyy\"))",
            "lineageTag": "1637d4a8-8b1a-4218-ad5b-1421dbcea351"
          },
          {
            "name": "TA coverage",
            "expression": "VAR d = [Latest date] RETURN IF(NOT ISBLANK(d), CALCULATE(DISTINCTCOUNT(Observation[AreaID]), REMOVEFILTERS(Area), REMOVEFILTERS('Date'), Area[Geography] = \"TA\", 'Date'[Date] = d))",
            "lineageTag": "db366aa2-8d11-49f4-b6e8-c06dc07536dc"
          },
          {
            "name": "Coverage display",
            "expression": "IF(ISBLANK([TA coverage]), \"Not available\", FORMAT([TA coverage], \"0\") & \" / 67\")",
            "lineageTag": "1aad73a2-a23a-4b41-b496-7dea28661d94"
          },
          {
            "name": "National value",
            "expression": "VAR d = [Latest date] RETURN IF(NOT ISBLANK(d), CALCULATE([Observed value], REMOVEFILTERS(Area), REMOVEFILTERS('Date'), Area[Geography] = \"NZ\", 'Date'[Date] = d))",
            "formatStringDefinition": {
              "expression": "SELECTEDVALUE(Indicator[NumberFormat], \"#,0.##\")"
            },
            "lineageTag": "541dbefa-f1ff-4079-91b3-ba60a99d1b93"
          },
          {
            "name": "National display",
            "expression": "VAR v = [National value] RETURN IF(ISBLANK(v), \"Not available\", FORMAT(v, SELECTEDVALUE(Indicator[NumberFormat], \"#,0\")))",
            "lineageTag": "41ccf54f-eb54-47be-977f-143b0b2e6beb"
          },
          {
            "name": "Top ten value",
            "expression": "VAR v = [Latest value] VAR leaders = TOPN(10, FILTER(ALL(Area), Area[Geography] = \"TA\" && NOT ISBLANK([Latest value])), [Latest value], DESC, Area[Area], ASC) RETURN IF(CONTAINS(leaders, Area[AreaID], SELECTEDVALUE(Area[AreaID])), v)",
            "formatStringDefinition": {
              "expression": "SELECTEDVALUE(Indicator[NumberFormat], \"#,0.##\")"
            },
            "lineageTag": "10e1a49f-46b5-4f99-8eb9-7f4e444d0b95"
          },
          {
            "name": "Metric note",
            "expression": "SELECTEDVALUE(Indicator[Definition], \"Choose one metric. Mixed measures are never added or averaged.\")",
            "lineageTag": "3acc901b-711b-4fa0-8dbf-a869456294a4"
          },
          {
            "name": "Unit label",
            "expression": "SELECTEDVALUE(Indicator[Unit], \"Select one metric\")",
            "lineageTag": "b0ebed74-5df4-4771-b995-417b2c8c46c7"
          },
          {
            "name": "Area label",
            "expression": "SELECTEDVALUE('Area picker'[Area], \"Select one territorial authority\")",
            "lineageTag": "acc93e24-701a-4996-9a92-96491f63b016"
          },
          {
            "name": "History note",
            "expression": "VAR n = CALCULATE(COUNTROWS(Observation), REMOVEFILTERS(Area), REMOVEFILTERS('Date'), TREATAS(VALUES('Area picker'[AreaID]), Area[AreaID])) RETURN IF(n < 2, \"One observation or no data: a trend cannot be inferred.\", \"Observed dates only. Gaps are not interpolated. National and TA dates must match for comparison.\")",
            "lineageTag": "cd6cc3fa-2d43-47a6-8ffd-b09c80b3c9d0"
          },
          {
            "name": "Source rows",
            "expression": "48953",
            "lineageTag": "05188dde-e97c-4490-93d0-5bcb3882cef0"
          },
          {
            "name": "Source repeated keys",
            "expression": "61",
            "lineageTag": "bebd02db-9564-4dae-98b3-0cf119e9480c"
          },
          {
            "name": "Selected rows",
            "expression": "13685",
            "lineageTag": "60dbbd3d-9218-48d2-af74-3d26d257197b"
          },
          {
            "name": "Selected duplicate keys",
            "expression": "0",
            "lineageTag": "f56d9674-30d9-4e68-b784-77b3eb234c9c"
          }
        ],
